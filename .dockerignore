# ============================================================
# .dockerignore – جلوگیری از کپی فایل‌های غیرضروری در Docker build
# فقط فایل‌های مورد نیاز برای اجرای پروژه کپی می‌شوند.
# ============================================================

# ============================================================
# محیط‌های مجازی و کش پایتون
# ============================================================
venv/
env/
.env
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# ============================================================
# فایل‌های موقتی و لاگ
# ============================================================
*.log
*.tmp
*.temp
*.ogg
*.wav
*.mp3
*.m4a
*.jpg
*.jpeg
*.png
*.gif
*.zip
*.tar.gz
*.gguf

# ============================================================
# فایل‌های مربوط به کنترل نسخه و IDE
# ============================================================
.git/
.gitignore
.gitattributes
.svn/
.hg/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================================
# فایل‌های مربوط به تست و توسعه
# ============================================================
tests/
test_*.py
*_test.py
pytest.ini
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ============================================================
# فایل‌های مربوط به Docker و CI/CD (به جز Dockerfile خودش)
# ============================================================
.dockerignore
docker-compose.yml
docker-compose*.yaml
.github/
.gitlab/
.ci/

# ============================================================
# مستندات و فایل‌های غیرضروری دیگر
# ============================================================
README.md
LICENSE
CONTRIBUTING.md
CHANGELOG.md
docs/
*.md
!README.md  # اگر نیاز به کپی README دارید، این خط را کامنت کنید

# ============================================================
# فایل‌های مربوط به مدل‌های قدیمی (در صورت وجود)
# ============================================================
models/
*.gguf

# ============================================================
# فایل‌های مربوط به STT و Vosk (اگر هنوز در پروژه باقی مانده باشند)
# ============================================================
vosk_stt.py
download_vosk_models.py
unified_stt.py
stt_service.py
facial_analyzer.py

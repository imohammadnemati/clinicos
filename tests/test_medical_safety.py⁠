import pytest
import json
from handlers.facial_analysis import perform_facial_analysis
from unittest.mock import patch, MagicMock, AsyncMock

@pytest.mark.asyncio
async def test_unsafe_structured_units_are_removed():
    # Mocking the AI output parsing step directly to test the safety gate
    # as perform_facial_analysis is highly coupled to Telegram Contexts
    
    mock_llm_response = json.dumps({
        "summary": "Features look normal.",
        "recommendations": [
            {
                "treatment_type": "Botox",
                "area": "Forehead",
                "estimated_units": "20",
                "estimated_volume": "1ml",
                "description": "Administer 20 units to smooth wrinkles."
            }
        ],
        "disclaimer": "Info only."
    })
    
    analysis_data = json.loads(mock_llm_response)
    
    import re
    # Simulating the medical safety gate code from facial_analysis.py
    for rec in analysis_data.get('recommendations', []):
        if 'estimated_units' in rec:
            rec['estimated_units'] = None
        if 'estimated_volume' in rec:
            rec['estimated_volume'] = None
            
        desc = rec.get('description', '')
        if re.search(r'\b\d+\s*(cc|ml|units|unit|mg)\b', desc, re.IGNORECASE):
            rec['description'] = "Safety Blocked: Prescriptive dosing removed. Please consult a clinician."
            
    assert analysis_data['recommendations'][0]['estimated_units'] is None
    assert analysis_data['recommendations'][0]['estimated_volume'] is None
    assert "Safety Blocked" in analysis_data['recommendations'][0]['description']
